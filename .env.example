# Copy to .env.local and restart — unlocks the live TMDB catalogue.
# A v3 API key or a v4 read access token both work.
NEXT_PUBLIC_TMDB_KEY=

# --- Backend PHP + MySQL (deploy Docker/Coolify) ---
# Copie para .env (local) ou cadastre as mesmas chaves no Coolify.
# NUNCA commite o .env com senhas reais. Só placeholders abaixo.
DB_NAME=minetv
DB_USER=noflix
DB_PASS=troque_por_uma_senha_forte
DB_ROOT_PASS=troque_por_uma_senha_root_forte

# URL interna do backend PHP (dentro da rede do compose)
PHP_BACKEND_URL=http://php:80

# TMDB no servidor (opcional; usado pelo front p/ capas/sinopses)
TMDB_API_KEY=
